            - name: STORAGE_PATH
              value: /models
          resources:
            requests:
              cpu: "8"
              memory: 48Gi
              nvidia.com/gpu: "1"
            limits:
              cpu: "16"
              memory: 64Gi
              nvidia.com/gpu: "1"
          volumeMounts:
            - name: models
              mountPath: /models
              readOnly: true
            - name: dshm
              mountPath: /dev/shm
            - name: ray-tmp
              mountPath: /tmp/ray
      volumes:
        - name: models
          persistentVolumeClaim:
            claimName: __MODEL_PVC_B__
        - name: dshm
          emptyDir:
            medium: Memory
            sizeLimit: 16Gi
        - name: ray-tmp
          emptyDir: {}
