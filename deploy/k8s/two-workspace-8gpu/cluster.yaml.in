              podAffinityTerm:
                topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchLabels:
                    app.kubernetes.io/name: serverlessllm-worker
                    spotserve.openai/cluster: __CLUSTER_NAME__
                    spotserve.openai/workspace: b
      containers:
        - name: worker
          image: __IMAGE__
          imagePullPolicy: IfNotPresent
          command: ["/bin/bash", "-lc"]
          args:
            - |
              set -euo pipefail
              ordinal="${HOSTNAME##*-}"
              export WORKER_ID="$((ordinal + 4))"
              exec /app/entrypoint.sh --mem-pool-size __MEM_POOL_SIZE__ --registration-required true
          env:
            - name: MODE
              value: WORKER
            - name: RAY_HEAD_ADDRESS
              value: __HEAD_SERVICE__.__WORKSPACE_A_NAMESPACE__.svc.cluster.local:6379
            - name: RAY_NODE_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            - name: SPOTSERVE_PHYSICAL_HOST_ID
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: SPOTSERVE_FAILURE_DOMAIN_ID
              value: workspace:__WORKSPACE_B_NAMESPACE__
            - name: VLLM_NIXL_SIDE_CHANNEL_HOST
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
