{
  "schema_version": 1,
  "description": "A controlled synthetic availability trace over an eight-GPU pool. A single active source GPU is reclaimed first and restored before a later two-GPU reclaim, so the first recovery is not confounded by cascading churn.",
  "units": {
    "capacity": "gpu",
    "time": "second"
  },
  "maximum_gpus": 8,
  "initial_available_gpus": 8,
  "initially_unavailable_targets": [],
  "events": [
    {
      "name": "reclaim-source-gpu-notice",
      "event": "preempt",
      "gpu_count": 1,
      "targets": ["pool-slot-3"],
      "time_s": 570.0,
      "grace_period_s": 30.0
    },
    {
      "name": "restore-first-reclaimed-gpu",
      "event": "add",
      "gpu_count": 1,
      "targets": ["pool-slot-3"],
      "time_s": 690.0,
      "node_info": {"free_gpu": 1, "total_gpu": 1, "state": "ready"}
    },
    {
      "name": "later-two-gpu-reclaim-notice",
      "event": "preempt",
      "gpu_count": 2,
      "targets": ["pool-slot-1", "pool-slot-5"],
      "time_s": 1170.0,
      "grace_period_s": 30.0
    },
    {
      "name": "restore-second-reclaimed-gpu",
      "event": "add",
      "gpu_count": 1,
      "targets": ["pool-slot-1"],
      "time_s": 1260.0,
      "node_info": {"free_gpu": 1, "total_gpu": 1, "state": "ready"}
    },
    {
      "name": "restore-third-reclaimed-gpu",
      "event": "add",
      "gpu_count": 1,
      "targets": ["pool-slot-5"],
      "time_s": 1320.0,
      "node_info": {"free_gpu": 1, "total_gpu": 1, "state": "ready"}
    }
  ],
  "constraints": {
    "target_generated_tokens_at_preempt": 512,
    "progress_min_tokens": 384,
    "progress_max_tokens": 640,
    "trace_end_s": 1440.0,
    "formal_burst_count": 6,
    "background_burst_times_s": [20.0, 360.0, 800.0, 1220.0]
  },
  "expected_capacity_path": [8, 7, 8, 6, 7, 8]
}
