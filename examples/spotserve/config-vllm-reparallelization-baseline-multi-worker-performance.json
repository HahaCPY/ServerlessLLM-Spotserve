{
  "model": "vllm-reparallelization-multi-worker-baseline",
  "backend": "vllm",
  "router_num_cpus": 0,
  "num_cpus": 1,
  "num_gpus": 1,
  "auto_scaling_config": {
    "metric": "concurrency",
    "target": 1,
    "min_instances": 1,
    "max_instances": 1,
    "keep_alive": 60
  },
  "backend_config": {
    "pretrained_model_name_or_path": "/models/vllm/vllm-dense-baseline",
    "load_format": "serverless_llm",
    "torch_dtype": "float16",
    "gpu_memory_utilization": 0.20,
    "max_model_len": 512,
    "max_num_seqs": 2,
    "tensor_parallel_size": 1,
    "pipeline_parallel_size": 1,
    "enable_prefix_caching": true,
    "enforce_eager": true,
    "trust_remote_code": true
  },
  "router_config": {
    "count_preempting_toward_capacity": true,
    "enable_reparallelization": false,
    "reparallelization_config": {
      "target_replica_gpus": 1,
      "max_tensor_parallel_size": 1,
      "max_pipeline_parallel_size": 1,
      "drain_timeout_s": 30,
      "allow_stop_before_recreate": true
    },
    "metrics_path": "/tmp/spotserve-work/results/spotserve_reparallelization_multi_worker_performance/vllm-reparallelization-multi-worker-baseline-router.jsonl"
  }
}
