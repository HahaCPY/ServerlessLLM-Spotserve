{"time_ms": 30000, "event": "add", "nodes": ["node-2"]}
{"time_ms": 60000, "event": "add", "nodes": ["node-3"]}
{"time_ms": 180000, "event": "remove", "nodes": ["node-0", "node-1"]}
{"time_ms": 240000, "event": "add", "nodes": ["node-0"]}
{"time_ms": 300000, "event": "remove", "nodes": ["node-2"]}
{"time_ms": 360000, "event": "add", "nodes": ["node-1", "node-2"]}
{"time_ms": 420000, "event": "remove", "nodes": ["node-3"]}
{"time_ms": 480000, "event": "add", "nodes": ["node-3"]}
{"time_ms": 540000, "event": "remove", "nodes": ["node-0"]}
{"time_ms": 600000, "event": "add", "nodes": ["node-0"]}
