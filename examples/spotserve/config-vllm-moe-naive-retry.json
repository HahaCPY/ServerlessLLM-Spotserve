{
  "model": "vllm-moe-naive-retry",
  "backend": "vllm",
  "router_num_cpus": 0,
  "num_cpus": 1,
  "num_gpus": 1,
  "auto_scaling_config": {
    "metric": "concurrency",
    "target": 2,
    "min_instances": 1,
    "max_instances": 2,
    "keep_alive": 60
