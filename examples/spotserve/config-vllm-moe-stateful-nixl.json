{
  "model": "vllm-moe-stateful-nixl",
  "backend": "vllm",
  "router_num_cpus": 0,
  "num_cpus": 1,
  "num_gpus": 4,
  "auto_scaling_config": {
    "metric": "concurrency",
    "target": 1,
    "min_instances": 1,
    "max_instances": 2,
    "keep_alive": 60
  },
  "backend_config": {
    "pretrained_model_name_or_path": "Qwen/Qwen1.5-MoE-A2.7B",
    "load_format": "auto",
    "torch_dtype": "float16",
    "gpu_memory_utilization": 0.85,
    "max_model_len": 2048,
    "max_num_seqs": 4,
    "tensor_parallel_size": 4,
    "pipeline_parallel_size": 1,
    "enable_expert_parallel": true,
    "enable_prefix_caching": true,
    "enforce_eager": true,
    "trace_debug": true,
    "trust_remote_code": true,
    "kv_transfer_config": {
      "kv_connector": "NixlConnector",
      "kv_role": "kv_both"
    }
  },
  "router_config": {
    "recovery_policy": "stateful_recovery",
    "max_retries": 2,
    "count_preempting_toward_capacity": true,
    "metrics_path": "/tmp/spotserve-work/results/spotserve_vllm_moe/vllm-moe-stateful-nixl-router.jsonl"
  }
}
