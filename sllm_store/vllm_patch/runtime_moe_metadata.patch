+    @staticmethod
+    def _merge_int_histogram(
+        target: dict[str, int],
+        source: Mapping[str, Any],
+    ) -> None:
+        for key, value in source.items():
+            try:
+                parsed = int(value)
+            except (TypeError, ValueError):
+                continue
+            if parsed > 0:
+                target[str(key)] = target.get(str(key), 0) + parsed
+
+    def get_request_moe_metadata(self, request_id: str) -> dict[str, Any]:
+        snapshots = self.model_executor.collective_rpc(
+            "get_request_moe_metadata", args=(request_id,)
+        )
+        selected_histogram: dict[str, int] = {}
+        worker_histograms: dict[str, dict[str, int]] = {}
+        sources: set[str] = set()
+        reasons: set[str] = set()
+        for index, snapshot in enumerate(snapshots or []):
+            if not isinstance(snapshot, dict):
+                continue
+            source = snapshot.get("moe_route_histogram_source")
+            if source:
+                sources.add(str(source))
+            reason = snapshot.get("reason")
+            if reason:
+                reasons.add(str(reason))
+            histogram_payload = snapshot.get(
+                "per_request_expert_route_histogram"
+            )
+            histogram = {}
+            if isinstance(histogram_payload, dict):
+                request_histogram = histogram_payload.get(request_id)
+                if isinstance(request_histogram, dict):
+                    for key, value in request_histogram.items():
+                        try:
+                            parsed = int(value)
+                        except (TypeError, ValueError):
+                            continue
+                        if parsed > 0:
+                            histogram[str(key)] = parsed
+            if not histogram:
+                continue
+            worker_key = str(snapshot.get("worker_rank", index))
+            worker_histograms[worker_key] = histogram
+            if not selected_histogram or sum(histogram.values()) > sum(
+                selected_histogram.values()
+            ):
+                selected_histogram = histogram
+
+        if not selected_histogram:
+            return {
+                "request_id": request_id,
+                "found": False,
+                "moe_route_histogram_available": False,
+                "moe_route_histogram_source": ",".join(sorted(sources))
+                or "vllm_runtime_topk",
+                "reason": ",".join(sorted(reasons))
+                or "no_moe_route_histogram",
+            }
+        return {
+            "request_id": request_id,
+            "found": True,
+            "moe_route_histogram_available": True,
+            "moe_route_histogram_source": ",".join(sorted(sources))
+            or "vllm_runtime_topk",
+            "moe_route_histogram_kind": "runtime_observed_topk",
+            "per_request_expert_route_histogram": {
+                request_id: selected_histogram
+            },
+            "worker_route_histograms": worker_histograms,
+        }
+
+    def get_moe_runtime_metadata(self) -> dict[str, Any]:
+        snapshots = self.model_executor.collective_rpc(
+            "get_moe_runtime_metadata"
+        )
+        global_histogram: dict[str, int] = {}
+        recent_histogram: dict[str, int] = {}
+        enabled = False
+        for snapshot in snapshots or []:
+            if not isinstance(snapshot, dict):
+                continue
+            enabled = enabled or bool(snapshot.get("moe_route_tracing_enabled"))
+            histogram = snapshot.get("global_expert_hotness")
+            if isinstance(histogram, dict):
+                self._merge_int_histogram(global_histogram, histogram)
+            recent = snapshot.get("recent_window_expert_hotness")
+            if isinstance(recent, dict):
+                self._merge_int_histogram(recent_histogram, recent)
+        available = bool(global_histogram)
+        return {
+            "moe_route_tracing_enabled": enabled,
+            "moe_route_histogram_available": available,
+            "moe_route_histogram_source": (
+                "vllm_runtime_topk" if available else "unavailable"
+            ),
+            "moe_route_histogram_kind": (
+                "runtime_observed_topk" if available else "unavailable"
+            ),
+            "global_expert_hotness": global_histogram,
+            "recent_window_expert_hotness": recent_histogram,
+        }
+
