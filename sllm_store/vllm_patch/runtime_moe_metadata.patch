+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Lightweight SpotServe MoE routing instrumentation.
+
+This module records request-level MoE routing histograms from the actual
+selected top-k expert IDs produced by vLLM's fused MoE layer.  It is disabled
+unless VLLM_SPOTSERVE_MOE_TRACE is set to a truthy value.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import threading
+from collections import deque
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass, field
+from typing import Any, Iterable, Iterator, Mapping, Sequence
+
+import torch
+
+_TRUTHY = {"1", "true", "yes", "on"}
+_ROUTE_CONTEXT: ContextVar["_RouteContext | None"] = ContextVar(
+    "spotserve_moe_route_context", default=None
+)
+_LOCK = threading.Lock()
+_PER_REQUEST_HISTOGRAMS: dict[str, dict[str, int]] = {}
+_GLOBAL_HISTOGRAM: dict[str, int] = {}
+_RECENT_EVENTS: deque[dict[str, int]] = deque(maxlen=64)
+_LAST_EXPERT_PLACEMENT_PLAN: dict[str, Any] = {}
+
+
+@dataclass
+class _RouteContext:
+    request_ids: tuple[str, ...]
+    token_counts: tuple[int, ...]
+    spans: tuple[tuple[int, int, str], ...]
+    layer_offsets: dict[str, int] = field(default_factory=dict)
+
+
+def _enabled() -> bool:
+    return os.environ.get("VLLM_SPOTSERVE_MOE_TRACE", "").lower() in _TRUTHY
+
+
+def _positive_int(value: Any) -> int:
+    try:
+        return max(0, int(value))
+    except (TypeError, ValueError):
+        return 0
+
+
+def _layer_id_from_name(layer_name: str | None) -> str:
+    if not layer_name:
+        return "unknown"
+    match = re.search(r"(?:^|\.)layers\.(\d+)(?:\.|$)", str(layer_name))
+    if match:
+        return match.group(1)
+    match = re.search(r"(?:^|/)layer[:/_-]?(\d+)(?:/|$)", str(layer_name))
+    if match:
+        return match.group(1)
+    return "unknown"
+
+
+def _expert_key(layer_name: str | None, expert_id: int) -> str:
+    layer_id = _layer_id_from_name(layer_name)
+    if layer_id == "unknown":
+        return f"expert:{expert_id}"
+    return f"layer:{layer_id}/expert:{expert_id}"
+
+
+def _merge_histogram(
+    target: dict[str, int],
+    source: Mapping[str, int],
+) -> None:
+    for key, value in source.items():
+        parsed = _positive_int(value)
+        if parsed > 0:
+            target[str(key)] = target.get(str(key), 0) + parsed
+
+
+def _placement_plan_payload(
+    expert_placement_plan: Mapping[str, Any] | None = None,
+    placement_plan: Mapping[str, Any] | None = None,
+    plan: Mapping[str, Any] | None = None,
+) -> dict[str, Any]:
+    for candidate in (expert_placement_plan, placement_plan, plan):
+        if isinstance(candidate, Mapping):
+            return dict(candidate)
+    return {}
+
+
+def _placement_plan_fingerprint(plan: Mapping[str, Any]) -> str:
+    value = plan.get("placement_fingerprint")
+    return str(value or "")
+
+
+def _tensor_to_int_list(value: Any) -> list[int]:
+    if value is None:
+        return []
+    try:
+        tensor = value.detach()
+        if tensor.is_cuda:
+            tensor = tensor.cpu()
+        return [int(item) for item in tensor.reshape(-1).tolist()]
+    except Exception:
+        try:
+            return [int(item) for item in value]
+        except Exception:
+            return []
+
+
+def _parameter_nbytes(value: Any) -> int:
+    try:
+        return int(value.numel()) * int(value.element_size())
+    except Exception:
+        return 0
+
+
+def _module_parameter_weight_bytes(module: Any, local_num_experts: int) -> int:
+    if local_num_experts <= 0:
+        return 0
+    total = 0
+    try:
+        parameters = module.named_parameters(recurse=False)
+    except Exception:
+        return 0
+    for name, parameter in parameters:
+        shape = tuple(getattr(parameter, "shape", ()) or ())
+        if not shape:
+            continue
+        if int(shape[0]) == local_num_experts:
+            total += _parameter_nbytes(parameter)
+            continue
+        if str(name) in {"w13_weight", "w2_weight", "w1_weight", "w3_weight"}:
+            total += _parameter_nbytes(parameter)
+    return total
+
+
+def _module_local_expert_ids(module: Any) -> tuple[list[int], str]:
+    global_num_experts = _positive_int(
+        getattr(
+            module,
+            "logical_num_experts",
+            getattr(module, "global_num_experts", getattr(module, "num_experts", 0)),
+        )
+    )
+    if global_num_experts <= 0:
+        return [], "missing_global_num_experts"
+
+    expert_map = getattr(module, "expert_map", None)
+    mapped = _tensor_to_int_list(expert_map)
+    if mapped:
+        local_physical_ids = [
+            physical_id
+            for physical_id, local_index in enumerate(mapped)
+            if int(local_index) >= 0
+        ]
+        logical_to_physical = getattr(
+            module, "logical_to_physical_map", None
+        )
+        try:
+            logical_rows = logical_to_physical.detach()
+            if logical_rows.is_cuda:
+                logical_rows = logical_rows.cpu()
+            logical_rows = logical_rows.tolist()
+        except Exception:
+            logical_rows = []
+        if logical_rows:
+            physical_to_logical = {
+                int(physical_id): logical_id
+                for logical_id, physical_ids in enumerate(logical_rows)
+                for physical_id in physical_ids
+                if int(physical_id) >= 0
+            }
+            local_logical_ids = sorted(
+                {
+                    physical_to_logical[physical_id]
+                    for physical_id in local_physical_ids
+                    if physical_id in physical_to_logical
+                }
+            )
+            if local_logical_ids:
+                return local_logical_ids, "eplb_logical_to_physical_map"
+        return local_physical_ids, "expert_map"
+
+    moe_parallel_config = getattr(module, "moe_parallel_config", None)
+    use_ep = bool(getattr(moe_parallel_config, "use_ep", False))
+    if not use_ep:
+        return list(range(global_num_experts)), "ep_disabled_all_experts_local"
+
+    ep_size = _positive_int(getattr(moe_parallel_config, "ep_size", 0))
+    ep_rank = _positive_int(getattr(moe_parallel_config, "ep_rank", 0))
+    if ep_size <= 1:
+        return list(range(global_num_experts)), "single_ep_rank_all_experts_local"
+
+    return [], "missing_expert_map_for_ep"
+
+
+def _rank_aliases(worker_rank: int | None, ep_rank: int | None) -> list[str]:
+    aliases: list[str] = []
+    if worker_rank is not None:
+        aliases.extend(
+            [
+                str(worker_rank),
+                f"rank:{worker_rank}",
+                f"worker:{worker_rank}",
+                f"worker-rank:{worker_rank}",
+            ]
+        )
+    if ep_rank is not None:
+        aliases.extend(
+            [
+                str(ep_rank),
+                f"ep-rank:{ep_rank}",
+                f"replica:0/ep-rank:{ep_rank}",
+                f"worker:{worker_rank}/ep-rank:{ep_rank}",
+            ]
+        )
+    return sorted({alias for alias in aliases if alias and "None" not in alias})
+
+
+def _expert_rank_matches(
+    expected_rank: Any,
+    actual: Mapping[str, Any],
+) -> bool:
+    expected = str(expected_rank or "")
+    if not expected:
+        return False
+    actual_rank = str(actual.get("rank_id") or "")
+    if expected == actual_rank:
+        return True
+    aliases = {str(alias) for alias in actual.get("rank_aliases", [])}
+    if expected in aliases:
+        return True
+    expected_ep = re.search(r"ep-rank:(\d+)", expected)
+    actual_ep = re.search(r"ep-rank:(\d+)", actual_rank)
+    if expected_ep and actual_ep and expected_ep.group(1) == actual_ep.group(1):
+        return True
+    for alias in aliases:
+        alias_ep = re.search(r"ep-rank:(\d+)", alias)
+        if expected_ep and alias_ep and expected_ep.group(1) == alias_ep.group(1):
+            return True
+    return False
+
+
+def inspect_runtime_expert_placement(
+    model: Any,
+    *,
+    worker_rank: int | None = None,
+    local_rank: int | None = None,
+    device: str | None = None,
+) -> dict[str, Any]:
+    """Inspect loaded MoE expert ownership on this worker.
+
+    This is read-only. It discovers actual resident expert ownership from
+    vLLM FusedMoE modules when their expert map and local expert weights are
+    visible. It does not remap ranks or move weights.
+    """
+    if model is None:
+        return {
+            "available": False,
+            "reason": "model_unavailable",
+            "worker_rank": worker_rank,
+            "local_rank": local_rank,
+            "device": device,
+            "shards": {},
+        }
+    try:
+        modules = model.named_modules()
+    except Exception:
+        return {
+            "available": False,
+            "reason": "model_named_modules_unavailable",
+            "worker_rank": worker_rank,
+            "local_rank": local_rank,
+            "device": device,
+            "shards": {},
+        }
+
+    shards: dict[str, dict[str, Any]] = {}
+    suspected_modules = 0
+    for module_name, module in modules:
+        if not (
+            hasattr(module, "global_num_experts")
+            or hasattr(module, "logical_num_experts")
+            or hasattr(module, "expert_map")
+        ):
+            continue
+        local_expert_ids, source = _module_local_expert_ids(module)
+        if not local_expert_ids:
+            continue
+        suspected_modules += 1
+        layer_id = _layer_id_from_name(str(module_name))
+        moe_parallel_config = getattr(module, "moe_parallel_config", None)
+        ep_rank_value = getattr(moe_parallel_config, "ep_rank", None)
+        ep_size_value = getattr(moe_parallel_config, "ep_size", None)
+        local_num_experts = _positive_int(
+            getattr(module, "local_num_experts", len(local_expert_ids))
+        )
+        module_weight_bytes = _module_parameter_weight_bytes(
+            module, local_num_experts or len(local_expert_ids)
+        )
+        per_expert_bytes = (
+            int(module_weight_bytes / max(1, len(local_expert_ids)))
+            if module_weight_bytes > 0
+            else 0
+        )
+        aliases = _rank_aliases(worker_rank, ep_rank_value)
+        rank_id = (
+            f"worker:{worker_rank}/ep-rank:{ep_rank_value}"
+            if ep_rank_value is not None
+            else f"worker:{worker_rank}"
+        )
+        for expert_id in local_expert_ids:
+            key = (
+                f"layer:{layer_id}/expert:{expert_id}"
+                if layer_id != "unknown"
+                else f"expert:{expert_id}"
+            )
+            shards[key] = {
+                "layer_id": layer_id,
+                "expert_id": int(expert_id),
+                "rank_id": rank_id,
+                "rank_aliases": aliases,
+                "worker_rank": worker_rank,
+                "local_rank": local_rank,
+                "device": device,
+                "ep_rank": ep_rank_value,
+                "ep_size": ep_size_value,
+                "module_name": str(module_name),
+                "placement_source": source,
+                "weight_resident": True,
+                "weight_size_bytes": per_expert_bytes,
+            }
+
+    return {
+        "available": bool(shards),
+        "reason": "runtime_expert_placement_snapshot"
+        if shards
+        else "no_expert_modules_discovered",
+        "worker_rank": worker_rank,
+        "local_rank": local_rank,
+        "device": device,
+        "suspected_moe_module_count": suspected_modules,
+        "shard_count": len(shards),
+        "shards": shards,
+    }
+
+
+def _compare_runtime_expert_placement(
+    plan: Mapping[str, Any],
+    runtime_snapshot: Mapping[str, Any] | None,
+) -> dict[str, Any]:
+    if not isinstance(runtime_snapshot, Mapping) or not runtime_snapshot.get("available"):
+        return {
+            "verified": False,
+            "reason": "runtime_expert_placement_snapshot_unavailable",
+            "actual_expert_placement_available": False,
+            "matched_expert_count": 0,
+            "missing_expert_count": 0,
+            "mismatched_rank_count": 0,
+        }
+    actual_shards = runtime_snapshot.get("shards", {})
+    if not isinstance(actual_shards, Mapping) or not actual_shards:
+        return {
+            "verified": False,
+            "reason": "runtime_expert_placement_snapshot_empty",
+            "actual_expert_placement_available": False,
+            "matched_expert_count": 0,
+            "missing_expert_count": 0,
+            "mismatched_rank_count": 0,
+        }
+    expected_ranks = plan.get("expert_to_target_rank", {})
+    if not isinstance(expected_ranks, Mapping) or not expected_ranks:
+        snapshot = plan.get("expert_placement_snapshot", {})
+        if isinstance(snapshot, Mapping):
+            expected_ranks = {
+                str(key): str(value.get("rank_id") or "")
+                for key, value in snapshot.items()
+                if isinstance(value, Mapping)
+            }
+    if not isinstance(expected_ranks, Mapping) or not expected_ranks:
+        return {
+            "verified": False,
+            "reason": "placement_contract_has_no_expected_expert_ranks",
+            "actual_expert_placement_available": True,
+            "matched_expert_count": 0,
+            "missing_expert_count": 0,
+            "mismatched_rank_count": 0,
+        }
+
+    def rank_is_local(expected_rank: Any) -> bool:
+        return any(
+            isinstance(actual, Mapping)
+            and _expert_rank_matches(expected_rank, actual)
+            for actual in actual_shards.values()
+        )
+
+    local_expected = {
+        str(expert_key): expected_rank
+        for expert_key, expected_rank in expected_ranks.items()
+        if rank_is_local(expected_rank)
+    }
+    unexpected_local = sum(
+        1 for expert_key in actual_shards if str(expert_key) not in local_expected
+    )
+    matched = 0
+    missing = 0
+    mismatched = 0
+    checked = 0
+    for expert_key, expected_rank in local_expected.items():
+        actual = actual_shards.get(str(expert_key))
+        if not isinstance(actual, Mapping):
+            missing += 1
+            continue
+        checked += 1
+        if _expert_rank_matches(expected_rank, actual):
+            matched += 1
+        else:
+            mismatched += 1
+
+    verified = bool(
+        local_expected
+        and matched == len(local_expected)
+        and missing == 0
+        and mismatched == 0
+        and unexpected_local == 0
+    )
+    return {
+        "verified": verified,
+        "reason": "runtime_expert_placement_matches_contract"
+        if verified
+        else "runtime_expert_placement_mismatch",
+        "actual_expert_placement_available": True,
+        "matched_expert_count": matched,
+        "missing_expert_count": missing,
+        "mismatched_rank_count": mismatched,
+        "unexpected_local_expert_count": unexpected_local,
+        "checked_expert_count": checked,
+        "local_expected_expert_count": len(local_expected),
+        "actual_expert_count": len(actual_shards),
+    }
+
+
+def _event_histogram(topk_ids: torch.Tensor, layer_name: str | None) -> dict[str, int]:
+    if topk_ids.numel() == 0:
+        return {}
+    ids = topk_ids.detach()
+    if ids.is_cuda:
+        ids = ids.cpu()
+    ids = ids.reshape(-1).to(torch.int64)
+    ids = ids[ids >= 0]
+    if ids.numel() == 0:
+        return {}
+    unique_ids, counts = torch.unique(ids, return_counts=True)
+    return {
+        _expert_key(layer_name, int(expert_id.item())): int(count.item())
+        for expert_id, count in zip(unique_ids, counts)
+        if int(count.item()) > 0
+    }
+
+
+@contextmanager
+def moe_request_context(
+    request_ids: Sequence[str],
+    token_counts: Sequence[int],
+) -> Iterator[None]:
+    if not _enabled():
+        yield
+        return
+
+    spans: list[tuple[int, int, str]] = []
+    offset = 0
+    normalized_request_ids: list[str] = []
+    normalized_token_counts: list[int] = []
+    for request_id, token_count in zip(request_ids, token_counts):
+        count = _positive_int(token_count)
+        if count <= 0:
+            continue
+        request_key = str(request_id)
+        spans.append((offset, offset + count, request_key))
+        normalized_request_ids.append(request_key)
+        normalized_token_counts.append(count)
+        offset += count
+
+    if not spans:
+        yield
+        return
+
+    token = _ROUTE_CONTEXT.set(
+        _RouteContext(
+            request_ids=tuple(normalized_request_ids),
+            token_counts=tuple(normalized_token_counts),
+            spans=tuple(spans),
+        )
+    )
+    try:
+        yield
+    finally:
+        _ROUTE_CONTEXT.reset(token)
+
+
+def record_moe_routing(
+    *,
+    layer_name: str | None,
+    topk_ids: torch.Tensor,
+) -> None:
+    if not _enabled():
+        return
+    context = _ROUTE_CONTEXT.get()
+    if context is None or topk_ids.numel() == 0:
+        return
+
+    num_rows = int(topk_ids.shape[0])
+    if num_rows <= 0:
+        return
+    layer_key = str(layer_name or "unknown")
+    start = context.layer_offsets.get(layer_key, 0)
+    end = start + num_rows
+    context.layer_offsets[layer_key] = end
+
+    request_updates: dict[str, dict[str, int]] = {}
+    for span_start, span_end, request_id in context.spans:
+        overlap_start = max(start, span_start)
+        overlap_end = min(end, span_end)
+        if overlap_start >= overlap_end:
+            continue
+        local_start = overlap_start - start
+        local_end = overlap_end - start
+        histogram = _event_histogram(topk_ids[local_start:local_end], layer_name)
+        if histogram:
+            request_updates.setdefault(request_id, {})
+            _merge_histogram(request_updates[request_id], histogram)
+
+    if not request_updates:
+        return
+
+    with _LOCK:
+        event_total: dict[str, int] = {}
+        for request_id, histogram in request_updates.items():
+            _PER_REQUEST_HISTOGRAMS.setdefault(request_id, {})
+            _merge_histogram(_PER_REQUEST_HISTOGRAMS[request_id], histogram)
+            _merge_histogram(_GLOBAL_HISTOGRAM, histogram)
+            _merge_histogram(event_total, histogram)
+        if event_total:
+            _RECENT_EVENTS.append(event_total)
+
+
+def clear_moe_request_metadata(request_ids: Iterable[str]) -> None:
+    request_keys = [str(request_id) for request_id in request_ids]
+    if not request_keys:
+        return
+    with _LOCK:
+        for request_id in request_keys:
+            _PER_REQUEST_HISTOGRAMS.pop(request_id, None)
+
+
+def get_request_moe_metadata(
+    request_id: str,
+    *,
+    worker_rank: int | None = None,
+) -> dict[str, Any]:
+    request_key = str(request_id)
+    with _LOCK:
+        histogram = dict(_PER_REQUEST_HISTOGRAMS.get(request_key, {}))
+    if not histogram:
+        return {
+            "request_id": request_key,
+            "found": False,
+            "moe_route_histogram_available": False,
+            "moe_route_histogram_source": (
+                "vllm_runtime_topk" if _enabled() else "disabled"
+            ),
+            "reason": (
+                "no_moe_route_histogram"
+                if _enabled()
+                else "moe_route_tracing_disabled"
+            ),
+            "worker_rank": worker_rank,
+        }
+    return {
+        "request_id": request_key,
+        "found": True,
+        "moe_route_histogram_available": True,
+        "moe_route_histogram_source": "vllm_runtime_topk",
+        "moe_route_histogram_kind": "runtime_observed_topk",
+        "per_request_expert_route_histogram": {request_key: histogram},
+        "worker_rank": worker_rank,
+    }
+
+
+def get_moe_runtime_metadata(
+    *,
+    runtime_expert_placement_snapshot: Mapping[str, Any] | None = None,
+    worker_rank: int | None = None,
+) -> dict[str, Any]:
+    with _LOCK:
+        recent: dict[str, int] = {}
+        for event in _RECENT_EVENTS:
+            _merge_histogram(recent, event)
+        global_histogram = dict(_GLOBAL_HISTOGRAM)
+    available = bool(global_histogram)
+    result = {
+        "moe_route_tracing_enabled": _enabled(),
+        "moe_route_histogram_available": available,
+        "moe_route_histogram_source": (
+            "vllm_runtime_topk" if available else "unavailable"
+        ),
+        "moe_route_histogram_kind": (
+            "runtime_observed_topk" if available else "unavailable"
+        ),
+        "global_expert_hotness": global_histogram,
+        "recent_window_expert_hotness": recent,
+        "worker_rank": worker_rank,
+    }
+    if isinstance(runtime_expert_placement_snapshot, Mapping):
+        result["runtime_expert_placement_available"] = bool(
+            runtime_expert_placement_snapshot.get("available")
+        )
+        result["runtime_expert_placement_reason"] = str(
+            runtime_expert_placement_snapshot.get("reason") or ""
+        )
+        result["runtime_expert_placement_shard_count"] = int(
+            runtime_expert_placement_snapshot.get("shard_count", 0) or 0
+        )
+        result["runtime_expert_placement_snapshot"] = dict(
+            runtime_expert_placement_snapshot
+        )
+    return result
+
+
+def apply_expert_placement_plan(
+    expert_placement_plan: Mapping[str, Any] | None = None,
+    *,
+    placement_plan: Mapping[str, Any] | None = None,
+    plan: Mapping[str, Any] | None = None,
+    runtime_expert_placement_snapshot: Mapping[str, Any] | None = None,
+    worker_rank: int | None = None,
+    **_: Any,
+) -> dict[str, Any]:
+    """Accept the SpotServe placement contract without moving weights.
+
+    This patched vLLM hook is intentionally observation-only. It lets the
+    ServerlessLLM controller verify that the runtime saw the requested
+    ExpertPlacementPlan, while keeping `applied=false` until vLLM exposes real
+    EP rank remapping / expert weight movement.
+    """
+    payload = _placement_plan_payload(
+        expert_placement_plan=expert_placement_plan,
+        placement_plan=placement_plan,
+        plan=plan,
+    )
+    with _LOCK:
+        _LAST_EXPERT_PLACEMENT_PLAN.clear()
+        _LAST_EXPERT_PLACEMENT_PLAN.update(payload)
+    actual_available = bool(
