+
+    async def get_request_moe_metadata(
+        self, request_id: str
+    ) -> dict[str, Any]:
+        resolver = getattr(self, "_spotserve_internal_request_ids", None)
+        internal_ids = (
+            resolver(request_id)
+            if callable(resolver)
+            else [request_id]
+            if request_id in self.output_processor.request_states
+            else []
+        )
+        if len(internal_ids) != 1:
+            return {
+                "request_id": request_id,
+                "found": False,
+                "moe_route_histogram_available": False,
+                "moe_route_histogram_source": "vllm_runtime_topk",
+                "reason": "request_not_active"
+                if not internal_ids
+                else "parallel_sampling_moe_metadata_not_supported",
+            }
+        internal_id = internal_ids[0]
+        engine_core = self.engine_core
+        request_engine = getattr(engine_core, "reqs_in_flight", {}).get(
+            internal_id
+        )
+        if request_engine is not None:
+            metadata = await engine_core._call_utility_async(
+                "get_request_moe_metadata", internal_id, engine=request_engine
+            )
+        else:
+            metadata = await engine_core.call_utility_async(
+                "get_request_moe_metadata", internal_id
+            )
+        if internal_id != request_id:
+            histogram = metadata.get("per_request_expert_route_histogram")
+            if isinstance(histogram, dict) and internal_id in histogram:
+                metadata["per_request_expert_route_histogram"] = {
+                    request_id: histogram[internal_id]
+                }
+        metadata["request_id"] = request_id
+        return metadata
+
+    async def get_moe_runtime_metadata(self, **_: Any) -> dict[str, Any]:
+        return await self.engine_core.call_utility_async(
+            "get_moe_runtime_metadata"
+        )
 
