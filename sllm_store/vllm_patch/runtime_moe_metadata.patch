+                if bool(snapshot.get("runtime_verified_placement"))
+            ),
+            "can_verify_physical_placement": any(
+                bool(snapshot.get("can_verify_physical_placement"))
+                for snapshot in worker_results
+            ),
+            "can_remap_live_ep_rank": any(
+                bool(snapshot.get("can_remap_live_ep_rank"))
+                for snapshot in worker_results
+            ),
+            "can_measure_all_to_all": any(
+                bool(snapshot.get("can_measure_all_to_all"))
+                for snapshot in worker_results
+            ),
+            "capability_reasons": ",".join(
+                sorted(
+                    {
+                        str(snapshot.get("capability_reason"))
+                        for snapshot in worker_results
+                        if snapshot.get("capability_reason")
+                    }
+                )
+            ),
+            "worker_results": worker_results,
+        }
+
+    def prepare_expert_placement_plan(
+        self,
+        expert_placement_plan: Mapping[str, Any] | None = None,
+    ) -> dict[str, Any]:
+        plan = dict(expert_placement_plan or {})
+        active_requests = self.scheduler.has_unfinished_requests()
+        if active_requests and not plan.get("allow_active_requests") is True:
+            return {
+                "ready": False,
+                "success": False,
+                "reason": "active_requests_must_be_drained_before_expert_remap",
+                "worker_count": 0,
+                "active_requests_at_barrier": True,
+                "step_boundary_barrier": True,
+            }
+        if active_requests and os.environ.get(
+            "VLLM_SPOTSERVE_ACTIVE_REQUEST_REMAP"
+        ) != "1":
+            return {
+                "ready": False,
+                "success": False,
+                "reason": "active_request_remap_not_enabled",
+                "worker_count": 0,
+                "active_requests_at_barrier": True,
+                "step_boundary_barrier": True,
+            }
+        if active_requests and (
+            self.batch_queue is not None or self.async_scheduling
+        ):
+            return {
+                "ready": False,
+                "success": False,
+                "reason": "active_request_remap_requires_sync_step_boundary",
+                "worker_count": 0,
+                "active_requests_at_barrier": True,
+                "step_boundary_barrier": False,
+            }
+        preflights = self.model_executor.collective_rpc(
+            "prepare_expert_placement_plan", args=(plan,),
+        )
+        result = self._aggregate_expert_placement_hook_results(
+            preflights,
+            "ready",
+            "expert_remap_preflight_failed",
+        )
+        result["active_requests_at_barrier"] = bool(active_requests)
+        result["step_boundary_barrier"] = True
+        return result
+
+    def apply_expert_placement_plan(
+        self,
+        expert_placement_plan: Mapping[str, Any] | None = None,
+    ) -> dict[str, Any]:
+        plan = dict(expert_placement_plan or {})
+        active_requests = False
+        if plan.get("live_expert_remap") is True:
+            if plan.get("dp_preflight_coordinated") is True:
+                active_requests = bool(plan.get("active_requests_at_barrier"))
+            else:
+                preflight = self.prepare_expert_placement_plan(plan)
+                if not preflight["ready"]:
+                    preflight["applied"] = False
+                    return preflight
+                active_requests = bool(
+                    preflight.get("active_requests_at_barrier")
+                )
+        try:
+            snapshots = self.model_executor.collective_rpc(
+                "apply_expert_placement_plan",
+                args=(plan,),
+            )
+        except Exception:
+            if plan.get("live_expert_remap") is True:
+                self._spotserve_expert_remap_failed = True
+            raise
+        result = self._aggregate_expert_placement_hook_results(
+            snapshots,
+            "applied",
+            "physical_expert_placement_migration_not_supported",
+        )
+        if plan.get("live_expert_remap") is True:
+            result["active_requests_at_barrier"] = bool(active_requests)
+            result["step_boundary_barrier"] = True
+            if not result["applied"]:
+                self._spotserve_expert_remap_failed = True
+        return result
+
+    def verify_expert_placement_plan(
+        self,
+        expert_placement_plan: Mapping[str, Any] | None = None,
+    ) -> dict[str, Any]:
+        plan = dict(expert_placement_plan or {})
+        try:
+            snapshots = self.model_executor.collective_rpc(
+                "verify_expert_placement_plan",
+                args=(plan,),
+            )
+        except Exception:
+            if plan.get("live_expert_remap") is True:
+                self._spotserve_expert_remap_failed = True
+            raise
+        result = self._aggregate_expert_placement_hook_results(
+            snapshots,
+            "verified",
+            "physical_expert_placement_verification_not_supported",
+        )
+        if plan.get("live_expert_remap") is True and not result["verified"]:
+            self._spotserve_expert_remap_failed = True
+        return result
+
