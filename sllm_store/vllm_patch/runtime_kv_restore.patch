+    def _spotserve_internal_request_ids(self, request_id: str) -> list[str]:
+        """Resolve one external request ID to active engine request IDs."""
+        if request_id in self.output_processor.request_states:
+            return [request_id]
+        suffix = f"_{request_id}"
+        return sorted(
+            req_id
+            for req_id in self.output_processor.request_states
+            if req_id.endswith(suffix)
+            and req_id[: -len(suffix)].isdigit()
+        )
+
+    async def export_inference_state(
+        self, request_id: str, **_: Any
+    ) -> dict[str, Any]:
+        internal_ids = self._spotserve_internal_request_ids(request_id)
+        if len(internal_ids) != 1:
+            return {
+                "supports_restore": False,
+                "reason": "request_not_active"
+                if not internal_ids
+                else "parallel_sampling_export_not_supported",
+            }
+        internal_id = internal_ids[0]
+        engine_core = self.engine_core
+        request_engine = getattr(engine_core, "reqs_in_flight", {}).get(
+            internal_id
+        )
+        if request_engine is not None:
+            state = await engine_core._call_utility_async(
+                "export_inference_state", internal_id, engine=request_engine
+            )
+        else:
+            state = await engine_core.call_utility_async(
+                "export_inference_state", internal_id
+            )
+        state["request_id"] = request_id
+        return state
+
+    async def supports_state_restore(self) -> bool:
+        return bool(
+            await self.engine_core.call_utility_async("supports_state_restore")
+        )
+
+    def restore_inference_state(
+        self, state: dict[str, Any], request_id: str, **_: Any
+    ) -> dict[str, Any]:
+        params = (state.get("runtime_state") or {}).get("kv_transfer_params")
+        if not isinstance(params, dict) or not params.get("remote_block_ids"):
+            return {"restored": False, "reason": "invalid_kv_transfer_payload"}
+        pending = getattr(self, "_spotserve_pending_kv_restores", None)
+        if pending is None:
+            pending = self._spotserve_pending_kv_restores = {}
+        pending[request_id] = dict(params)
+        return {
+            "restored": False,
+            "staged": True,
+            "expected_blocks": len(params["remote_block_ids"]),
+        }
