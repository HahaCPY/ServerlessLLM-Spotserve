+    async def get_request_kv_metadata(self, request_id: str) -> dict[str, Any]:
+        """Get a point-in-time KV metadata snapshot from EngineCore."""
+        child_ids = sorted(
+            req_id
+            for req_id in self.output_processor.request_states
+            if req_id.endswith(f"_{request_id}")
+            and req_id[: -len(request_id) - 1].isdigit()
+        )
+        if child_ids:
+            return {
+                "request_id": request_id,
+                "found": False,
+                "reason": "parallel_sampling_metadata_not_supported",
+                "sequence_ids": child_ids,
+            }
+        engine_core = self.engine_core
+        request_engine = getattr(engine_core, "reqs_in_flight", {}).get(
+            request_id
+        )
+        if request_engine is not None:
+            return await engine_core._call_utility_async(
+                "get_request_kv_metadata",
+                request_id,
+                engine=request_engine,
+            )
+        return await engine_core.call_utility_async(
+            "get_request_kv_metadata", request_id
+        )
+
+    async def get_all_request_kv_metadata(self) -> list[dict[str, Any]]:
+        """Get live KV metadata for all requests known to this frontend."""
+        request_ids = list(self.output_processor.request_states)
+        if not request_ids:
+            return []
+        return await asyncio.gather(
+            *(self.get_request_kv_metadata(req_id) for req_id in request_ids)
+        )
+
